@model Inventory.Models.Category

@{
    ViewData["Title"] = "Delete Category";
}

<h2 class="mb-4 text-danger">Delete Category</h2>

<div class="card p-4 shadow-sm">

    <form asp-action="Delete">

        <input type="hidden" asp-for="CId" />

        <div class="mb-3">

            <label asp-for="CategoryName"
                   class="form-label"></label>

            <input asp-for="CategoryName"
                   class="form-control"
                   readonly />

        </div>

        <button type="submit"
                class="btn btn-danger">
            Delete
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back
        </a>

    </form>

</div>@*
