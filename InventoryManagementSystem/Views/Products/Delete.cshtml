@model Inventory.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<h2 class="mb-4 text-danger">Delete Product</h2>

<div class="card p-4 shadow-sm border-danger">

    <h5>Are you sure you want to delete this product?</h5>

    <hr />

    <dl class="row">
        <dt class="col-sm-3">Product Name</dt>
        <dd class="col-sm-9">@Model.ProductName</dd>

        <dt class="col-sm-3">Category</dt>
        <dd class="col-sm-9">@Model.Category</dd>

        <dt class="col-sm-3">Price</dt>
        <dd class="col-sm-9">@Model.Price</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="PId" />

        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>

</div>