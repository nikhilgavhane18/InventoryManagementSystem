<!DOCTYPE html>
<html>
<head>
    <title>Admin Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            margin: 0;
        }

        .sidebar {
            width: 250px;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            background-color: #343a40;
            padding-top: 20px;
        }

            .sidebar a {
                padding: 12px 20px;
                display: block;
                color: white;
                text-decoration: none;
            }

                .sidebar a:hover {
                    background-color: #495057;
                }

        .content {
            margin-left: 250px;
            padding: 20px;
        }

        .sidebar-title {
            color: white;
            text-align: center;
            margin-bottom: 20px;
            font-weight: bold;
        }
    </style>
</head>
<body>

    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-title">Admin Panel</div>

        <a asp-controller="Dashboard" asp-action="Index">🏠 Dashboard</a>
        <a asp-controller="Products" asp-action="Index">📦 Products</a>
        <a asp-controller="Category" asp-action="Index">📁 Categories</a>
        <a asp-controller="Stock" asp-action="Index">📊 Stock</a>
        <a asp-controller="Suppliers" asp-action="Index">🚚 Suppliers</a>
        <a asp-controller="Order" asp-action="Index">🧾 Orders</a>
        <a asp-controller="Users" asp-action="Index">👤 Users</a>

        <a asp-controller="Account" asp-action="Logout">🚪 Logout</a>
    </div>

    <!-- Page Content -->
    <div class="content">
        @RenderBody()
    </div>

</body>
</html>